# Environment variables for Tours Advisor
# Copy this file to .env and update with your secure values
# NEVER commit .env to version control!

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Keycloak Database
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=your_secure_keycloak_db_password_here

# Keycloak Admin Console
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_secure_admin_password_here

# Application Database
APP_DB_USER=app_user
APP_DB_PASSWORD=your_secure_app_db_password_here

# HashiCorp Vault
VAULT_ROOT_TOKEN=dev-only-token-change-in-production

# Generate secure passwords with:
# openssl rand -base64 32